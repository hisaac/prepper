#!/usr/bin/env bash

# shellcheck source=../src/lib/common.bash
. "$(dirname -- "$(dirname -- "$(realpath "${BASH_SOURCE[0]}")")")/src/lib/common.bash" || exit 1
. "${MODULES[defaults]}" || exit 1

function main() {
	log_info "This is a prepper script. It can be used to prepare the environment before running the main actions."
	log_info "defaults.domains:"
	defaults.domains
}

main "$@"
